# 复制本文件为 .env 并填入你的 key（.env 已被 gitignore，不会入库）
# LLM 通道：任意 OpenAI 兼容 API。默认 DeepSeek（便宜、JSON 输出稳）。

# DeepSeek（推荐，https://platform.deepseek.com 充几块钱够跑几个月）
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

# 备选：通义千问（注释掉上面三行，放开下面三行）
# AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_MODEL=qwen-plus
